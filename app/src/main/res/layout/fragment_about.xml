<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App 图标"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/tv_about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前版本：v1.3.1"
            android:textSize="14sp"
            android:textColor="#2196F3"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"/>

        <!-- 项目简介 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_round"
            android:padding="18dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="项目简介"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#1976D2"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="一款开源的 Android 文件自动备份工具。定时扫描手机里的指定目录，自动把新增文件上传到你的七牛云对象存储，实现文件自动云端备份。"
                android:textSize="13sp"
                android:textColor="#666666"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- 开源地址 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_round"
            android:padding="18dp"
            android:layout_marginTop="12dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开源地址（点击跳转浏览器）"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#1976D2"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GitHub"
                android:textSize="12sp"
                android:textColor="#999999"/>

            <TextView
                android:id="@+id/tv_about_github"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://github.com/frwuc/s3-fileuploader"
                android:textSize="13sp"
                android:textColor="#1976D2"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gitee（码云）"
                android:textSize="12sp"
                android:textColor="#999999"/>

            <TextView
                android:id="@+id/tv_about_gitee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://gitee.com/frwuc/s3-fileuploader"
                android:textSize="13sp"
                android:textColor="#C71D23"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="联系邮箱（点击发送邮件）"
                android:textSize="12sp"
                android:textColor="#999999"/>

            <TextView
                android:id="@+id/tv_about_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="frwucc@163.com"
                android:textSize="13sp"
                android:textColor="#1976D2"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_about_license"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开源协议：MIT License"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="隐私说明：AK/SK 仅保存在手机本地，文件只上传到你自己的七牛云 bucket，不经手任何第三方服务器。"
            android:textSize="12sp"
            android:textColor="#999999"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
