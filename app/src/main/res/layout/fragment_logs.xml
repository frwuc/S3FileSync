<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- 渐变头部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_header"
        android:padding="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 日志"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="查看上传记录与执行日志"
            android:textSize="13sp"
            android:textColor="#E3F2FD"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- 标签切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_tab_upload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="上传记录"
            android:backgroundTint="#1976D2"
            android:textColor="@android:color/white"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_tab_exec"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="执行日志"
            android:backgroundTint="#607D8B"
            android:textColor="@android:color/white"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最新记录在前，最多显示 200 条"
        android:textSize="12sp"
        android:textColor="#999999"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"/>

    <!-- 内容区：圆角卡片 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_logs_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_round"
                android:padding="16dp"
                android:elevation="3dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_clear_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清空全部记录"
        android:backgroundTint="#F44336"
        android:textColor="@android:color/white"
        android:layout_margin="16dp"/>
</LinearLayout>
