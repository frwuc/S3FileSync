<?xml version="1.0" encoding="utf-8"?>
<!-- 日志记录页：逐个文件的上传结果明细 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- 渐变头部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_header"
        android:padding="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 日志记录"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="每个文件的上传结果明细，含云端路径与访问地址"
            android:textSize="13sp"
            android:textColor="#E3F2FD"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_logs_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最新记录在前，最多显示 200 条"
        android:textSize="12sp"
        android:textColor="#999999"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_logs_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_round"
                android:padding="20dp"
                android:text="暂无日志记录。\n执行一次同步后，这里会逐个列出每个文件的上传结果。"
                android:textSize="13sp"
                android:textColor="#8A8A8A"
                android:lineSpacingExtra="4dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/container_log_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_clear_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清空日志记录"
        android:backgroundTint="#F44336"
        android:textColor="@android:color/white"
        android:layout_margin="16dp"/>
</LinearLayout>
