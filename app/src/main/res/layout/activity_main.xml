<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="七牛云配置（在 App 界面填写）"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_access_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AccessKey"
            android:inputType="text"/>

        <EditText
            android:id="@+id/et_secret_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SecretKey"
            android:inputType="text"/>

        <EditText
            android:id="@+id/et_bucket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bucket名称"
            android:inputType="text"/>

        <EditText
            android:id="@+id/et_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="域名（如 https://z0.qbox.me）"
            android:inputType="textUri"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="每天执行时间点（可添加多个，如 10:00、19:00）"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/times_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <Button
            android:id="@+id/btn_add_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 添加时间点"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存配置并启用定时任务"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"/>

        <Button
            android:id="@+id/btn_execute_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即执行一次上传"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置电池优化白名单（vivo 必做）"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：未启动"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#666666"/>

    </LinearLayout>
</ScrollView>
