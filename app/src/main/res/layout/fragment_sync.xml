<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="截图同步"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="到设定时间自动把新增截图上传到七牛云"
            android:textSize="13sp"
            android:textColor="#999999"
            android:layout_marginBottom="16dp"/>

        <!-- 配置状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前配置"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_sync_bucket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bucket：未设置"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tv_sync_dirs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="本地目录：未设置"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tv_sync_cloud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="云端目录：未设置"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tv_sync_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="定时时间：未设置"
                android:textSize="13sp"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- 立即同步大按钮 -->
        <Button
            android:id="@+id/btn_sync_now"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚡ 立即同步"
            android:textSize="17sp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扫描本地截图目录，把新增图片上传到云端"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="4dp"/>

        <!-- 运行状态 -->
        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：就绪"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#EEEEEE"
            android:textSize="13sp"
            android:textColor="#555555"/>

        <!-- 未配置提示 -->
        <TextView
            android:id="@+id/tv_sync_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 尚未完成配置，请先到「设置」填写七牛云账号与目录"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#FFF3E0"
            android:textSize="13sp"
            android:textColor="#E65100"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
