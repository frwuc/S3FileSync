{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S3FileSync",
  "mainBinaryName": "S3FileSync",
  "version": "1.2.0",
  "identifier": "com.frwuc.s3filesync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "S3FileSync — 文件同步",
        "width": 980,
        "height": 660,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
